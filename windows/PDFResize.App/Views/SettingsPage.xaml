<Page
    x:Class="PDFResize.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="28,20,28,28" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" MaxWidth="920" HorizontalAlignment="Stretch">

            <StackPanel Spacing="4">
                <TextBlock Text="设置" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="外观材质、多核子进程隔离策略与历史已优化指纹数据库管理"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Card 1: Appearance -->
            <Border Style="{StaticResource FluentCardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Glyph="&#xE790;"
                        FontSize="20"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="应用主题外观 (Fluent Mica)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Text="主窗口启用 Windows 11 原生云母 (Mica) 透景材质，自动适配系统深浅色与强调色"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ComboBox
                        x:Name="ThemeCombo"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="跟随 Windows 系统默认" Tag="Default" />
                        <ComboBoxItem Content="浅色模式 (Light)" Tag="Light" />
                        <ComboBoxItem Content="深色模式 (Dark)" Tag="Dark" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Card 2: Parallel Worker Pool -->
            <Border Style="{StaticResource FluentCardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Glyph="&#xE950;"
                        FontSize="20"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="默认并行隔离子进程数" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            Text="每个 PDF 在独立的无界面子进程 (--worker-one) 中完成解码与重编码，进程退出瞬间 100% 归还非托管内存，连续跑完 60GB 零内存膨胀"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <NumberBox
                        x:Name="DefaultWorkersBox"
                        Grid.Column="2"
                        Minimum="1"
                        Maximum="16"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        VerticalAlignment="Center"
                        ValueChanged="DefaultWorkersBox_ValueChanged" />
                </Grid>
            </Border>

            <!-- Card 3: Fingerprint Cache & SQLite Database -->
            <Border Style="{StaticResource FluentCardBorderStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Glyph="&#xEE94;"
                            FontSize="20"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="历史已优化指纹缓存 (SQLite WAL)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Name="FingerprintCountText"
                                Text="当前已记录 0 个已优化文件指纹"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Button Grid.Column="2" Content="打开数据目录" Click="OpenDbDir_Click" />
                        <Button Grid.Column="3" Content="重置跳过缓存" Click="ClearFingerprints_Click" />
                    </Grid>

                    <TextBlock
                        x:Name="DbPathLabel"
                        Text=""
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- Card 4: About Native WinUI 3 Engine -->
            <Border Style="{StaticResource FluentCardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="关于 PDF Resize · Windows 原生客户端" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="• 界面框架：Windows App SDK 1.6 / WinUI 3 (.NET 8 原生桌面，零 WebView 套壳)"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="• 压缩内核：PDFsharp 6 结构保留引擎 + SkiaSharp 原生位图重采样（100% 保留矢量文字、字体子集、目录书签与超链接）"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="• 安全机制：同卷 .pdfresize.tmp 临时写入 → 页数与交叉引用表完整性验证 → 变大自动放弃 → MoveFileExW 原子替换"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

<Page
    x:Class="PDFResize.App.Views.JobsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PDFResize.Core.Models">

    <Grid Padding="24,18,24,18" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Job Selector & Lifecycle Controls -->
        <Border Grid.Row="0" Style="{StaticResource FluentCardBorderStyle}" Padding="16,12,16,12">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Text="当前批次："
                        VerticalAlignment="Center"
                        Style="{ThemeResource BodyStrongTextBlockStyle}" />

                    <ComboBox
                        x:Name="JobSelectorCombo"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="JobSelectorCombo_SelectionChanged" />

                    <Border
                        Grid.Column="2"
                        CornerRadius="4"
                        Padding="10,4,10,4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="JobStatusText"
                            Text="暂无任务"
                            FontSize="12"
                            Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    </Border>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PauseJobBtn" Content="暂停" Click="PauseJob_Click" Visibility="Collapsed" />
                        <Button x:Name="ResumeJobBtn" Content="继续压缩" Click="ResumeJob_Click" Style="{ThemeResource AccentButtonStyle}" Visibility="Collapsed" />
                        <Button x:Name="RetryFailedBtn" Content="重试失败项" Click="RetryFailed_Click" Visibility="Collapsed" />
                        <Button x:Name="CancelJobBtn" Content="取消" Click="CancelJob_Click" Visibility="Collapsed" />
                        <Button x:Name="DeleteJobBtn" Content="删除记录" Click="DeleteJob_Click" />
                    </StackPanel>
                </Grid>

                <!-- Determinate Progress + Active Workers Strip -->
                <StackPanel Spacing="6">
                    <ProgressBar
                        x:Name="JobProgressBar"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
                        Height="8" />
                    <Grid>
                        <TextBlock
                            x:Name="ProgressSummaryText"
                            Text="等待新建批量压缩任务…"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="ActiveFilesText"
                            Text=""
                            FontSize="12"
                            HorizontalAlignment="Right"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            MaxWidth="560" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Row 1: 4 Fluent KPI Cards -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource FluentSubtleCardBorderStyle}">
                <StackPanel Spacing="3">
                    <TextBlock Text="本批次已释放空间" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="KpiSavedBytesText" Text="0 B" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="KpiSavedPctText" Text="平均压缩率 0.0%" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource FluentSubtleCardBorderStyle}">
                <StackPanel Spacing="3">
                    <TextBlock Text="已处理体积对比" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="KpiVolumePairText" Text="0 B → 0 B" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="KpiTotalOrigText" Text="批次总计 0 B" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource FluentSubtleCardBorderStyle}">
                <StackPanel Spacing="3">
                    <TextBlock Text="实时吞吐速度" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="KpiSpeedText" Text="—" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="KpiEtaText" Text="预计剩余：—" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource FluentSubtleCardBorderStyle}">
                <StackPanel Spacing="3">
                    <TextBlock Text="文件状态统计" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="KpiCountsMainText" Text="0 / 0" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="KpiCountsSubText" Text="已优化 0 · 跳过 0 · 失败 0" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 2: Filter Pills & Search Box -->
        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button x:Name="FilterAllBtn" Tag="all" Content="全部" Click="StatusFilter_Click" />
                <Button x:Name="FilterDoneBtn" Tag="Done" Content="已优化" Click="StatusFilter_Click" />
                <Button x:Name="FilterSkippedBtn" Tag="skipped" Content="已跳过" Click="StatusFilter_Click" />
                <Button x:Name="FilterFailedBtn" Tag="Failed" Content="失败" Click="StatusFilter_Click" />
                <Button x:Name="FilterPendingBtn" Tag="Pending" Content="等待中" Click="StatusFilter_Click" />
            </StackPanel>

            <TextBox
                x:Name="SearchBox"
                Grid.Column="1"
                PlaceholderText="按文件名或子文件夹路径筛选（支持 3,000+ 文件虚拟化秒搜）…"
                TextChanged="SearchBox_TextChanged" />

            <Button Grid.Column="2" Click="NewJobFromWorkbench_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                    <TextBlock Text="新建压缩任务" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Row 3: Table Column Header -->
        <Border
            Grid.Row="3"
            Padding="14,8,14,8"
            CornerRadius="6,6,0,0"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="68" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="86" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="状态" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="文件相对路径（含源目录标签）" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="页数" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="3" Text="原始大小" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="4" Text="优化后" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="5" Text="节省体积" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="6" Text="耗时" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="7" Text="操作" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Row 4: Virtualized File Rows ListView -->
        <Border
            Grid.Row="4"
            CornerRadius="0,0,8,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,1,1">
            <Grid>
                <ListView
                    x:Name="FilesListView"
                    SelectionMode="None"
                    Padding="0,4,0,4">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:JobFileRow">
                            <Grid Padding="6,6,6,6" ColumnSpacing="10" ToolTipService.ToolTip="{x:Bind DetailHint}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    CornerRadius="4"
                                    Padding="7,2,7,2"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind StatusText}" FontSize="11" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{x:Bind RelativePath}"
                                        TextTrimming="CharacterEllipsis"
                                        FontSize="13" />
                                    <TextBlock
                                        Text="{x:Bind DetailHint}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{x:Bind PagesText}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind OriginalSizeText}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{x:Bind NewSizeText}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{x:Bind SavedText}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="6" Text="{x:Bind DurationText}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button
                                        Tag="{x:Bind EffectivePath}"
                                        Click="RevealRowFile_Click"
                                        Padding="6,4,6,4"
                                        ToolTipService.ToolTip="在资源管理器中定位">
                                        <FontIcon Glyph="&#xE8DA;" FontSize="12" />
                                    </Button>
                                    <Button
                                        Tag="{x:Bind EffectivePath}"
                                        Click="CompareRowFile_Click"
                                        Padding="6,4,6,4"
                                        ToolTipService.ToolTip="在画质对比页打开">
                                        <FontIcon Glyph="&#xE8A1;" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Name="EmptyRowsHintText"
                    Text="当前筛选条件下没有文件记录"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Page>

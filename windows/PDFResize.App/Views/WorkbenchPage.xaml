<Page
    x:Class="PDFResize.App.Views.WorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PDFResize.Core.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            Grid.Row="0"
            Padding="28,20,28,24"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18" MaxWidth="1120" HorizontalAlignment="Stretch">

                <!-- Page Header -->
                <StackPanel Spacing="4">
                    <TextBlock
                        Text="批量压缩工作台"
                        Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock
                        Text="专为 60GB / 3,000+ 海量 PDF 打造 · 支持跨盘符多文件夹去重、100% 矢量文字保留与原地原子替换"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Card 1: Multi-Folder & PDF Source Management -->
                <Border Style="{StaticResource FluentCardBorderStyle}">
                    <StackPanel Spacing="16">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        Glyph="&#xE8B7;"
                                        FontSize="18"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock
                                        Text="待压缩文件夹与 PDF 列表"
                                        Style="{ThemeResource SubtitleTextBlockStyle}" />
                                </StackPanel>
                                <TextBlock
                                    Text="可按住 Ctrl / Shift 一次多选多个文件夹，或直接从 Windows 资源管理器把任意文件夹拖入窗口"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                                <Button
                                    Click="PickFolders_Click"
                                    Style="{ThemeResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                                        <TextBlock Text="选择多个文件夹…" />
                                    </StackPanel>
                                </Button>
                                <Button Click="PickFiles_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                        <TextBlock Text="添加 PDF…" />
                                    </StackPanel>
                                </Button>
                                <Button Click="Rescan_Click" ToolTipService.ToolTip="重新扫描文件夹体积与待处理数量">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                        <TextBlock Text="扫描" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="ClearSourcesBtn"
                                    Click="ClearSources_Click"
                                    Content="清空" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox
                                x:Name="RecursiveCheck"
                                Content="递归包含所有子文件夹中的 PDF"
                                IsChecked="True"
                                Click="RecursiveCheck_Click" />
                            <ProgressRing
                                x:Name="ScanSpinner"
                                Width="18"
                                Height="18"
                                IsActive="False"
                                Visibility="Collapsed" />
                        </StackPanel>

                        <!-- Empty Drop Hint -->
                        <Border
                            x:Name="EmptySourcesHint"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            Padding="24,28,24,28">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <FontIcon
                                    Glyph="&#xE8B7;"
                                    FontSize="30"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    HorizontalAlignment="Center" />
                                <TextBlock
                                    Text="尚未添加任何文件夹或 PDF"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    HorizontalAlignment="Center" />
                                <TextBlock
                                    Text="点击右上角「选择多个文件夹…」或直接将文件夹拖入此窗口即可自动统计 PDF 数量与体积"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Populated Folder List -->
                        <ItemsControl x:Name="SourcesItemsControl" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:SourceFolderSummary">
                                    <Border
                                        Margin="0,0,0,6"
                                        Padding="12,8,12,8"
                                        CornerRadius="6"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon
                                                Glyph="&#xE8B7;"
                                                FontSize="16"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{x:Bind DisplayName}"
                                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{x:Bind Path}"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Border
                                                Grid.Column="2"
                                                CornerRadius="4"
                                                Padding="8,3,8,3"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{x:Bind BadgeText}"
                                                    FontSize="12" />
                                            </Border>

                                            <Button
                                                Grid.Column="3"
                                                Tag="{x:Bind Path}"
                                                Click="RevealSource_Click"
                                                ToolTipService.ToolTip="在资源管理器中打开">
                                                <FontIcon Glyph="&#xE8DA;" FontSize="13" />
                                            </Button>

                                            <Button
                                                Grid.Column="4"
                                                Tag="{x:Bind Path}"
                                                Click="RemoveSource_Click"
                                                ToolTipService.ToolTip="从列表移除">
                                                <FontIcon Glyph="&#xE711;" FontSize="13" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 4-Metric Scan KPI Strip + Sample Quick Compare -->
                        <StackPanel x:Name="ScanMetricsPanel" Visibility="Collapsed" Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource FluentSubtleCardBorderStyle}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="扫描 PDF 总数" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="KpiTotalFiles" Text="0" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource FluentSubtleCardBorderStyle}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="原始总体积" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="KpiTotalBytes" Text="0 B" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource FluentSubtleCardBorderStyle}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="本次待优化" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="KpiPendingFiles" Text="0" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Style="{StaticResource FluentSubtleCardBorderStyle}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="历史已优化跳过" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="KpiSkippedFiles" Text="0" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="抽样大文件预览："
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox
                                    x:Name="SamplePdfCombo"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch" />
                                <Button
                                    Grid.Column="2"
                                    Click="OpenSelectedSampleInCompare_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8A1;" FontSize="14" />
                                        <TextBlock Text="先对比此文件画质" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 2: Compression Presets & Parameters -->
                <Border Style="{StaticResource FluentCardBorderStyle}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        Glyph="&#xE9E9;"
                                        FontSize="18"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock
                                        Text="压缩档位与画质参数"
                                        Style="{ThemeResource SubtitleTextBlockStyle}" />
                                </StackPanel>
                                <TextBlock
                                    Text="仅重编码 PDF 内嵌高分辨率位图，矢量文字、表格线条、目录书签与超链接 100% 原样保留"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                CornerRadius="4"
                                Padding="10,4,10,4"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="ActivePresetBadge"
                                    Text="当前：均衡推荐"
                                    FontSize="12"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                        </Grid>

                        <!-- 4 Fluent Preset Cards -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="PresetLosslessBtn"
                                Grid.Column="0"
                                Tag="Lossless"
                                Click="PresetBtn_Click"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="14,12,14,12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="无损清理" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="仅流重压缩与结构清理" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="约省 5%–20%" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="PresetLightBtn"
                                Grid.Column="1"
                                Tag="Light"
                                Click="PresetBtn_Click"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="14,12,14,12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="高清轻压" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="200 DPI · JPEG 82%" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="约省 25%–50%" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="PresetBalancedBtn"
                                Grid.Column="2"
                                Tag="Balanced"
                                Click="PresetBtn_Click"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="14,12,14,12">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="均衡推荐" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="推荐" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="150 DPI · JPEG 70%" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="约省 45%–75%" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="PresetExtremeBtn"
                                Grid.Column="3"
                                Tag="Extreme"
                                Click="PresetBtn_Click"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="14,12,14,12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="极致瘦身" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="100 DPI · JPEG 50%" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="约省 65%–88%" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- DPI & JPEG Quality Sliders -->
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource FluentSubtleCardBorderStyle}">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="目标图像分辨率 (DPI)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            x:Name="DpiValueLabel"
                                            Text="150 DPI"
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Grid>
                                    <Slider
                                        x:Name="DpiSlider"
                                        Minimum="72"
                                        Maximum="300"
                                        StepFrequency="6"
                                        Value="150"
                                        ValueChanged="DpiSlider_ValueChanged" />
                                    <TextBlock
                                        Text="高于目标分辨率的巨幅扫描图将平滑降采样；1-bit 黑白文字扫描件自动保护"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource FluentSubtleCardBorderStyle}">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="JPEG 图像重编码质量" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            x:Name="QualityValueLabel"
                                            Text="70%"
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Grid>
                                    <Slider
                                        x:Name="QualitySlider"
                                        Minimum="25"
                                        Maximum="95"
                                        StepFrequency="5"
                                        Value="70"
                                        ValueChanged="QualitySlider_ValueChanged" />
                                    <TextBlock
                                        Text="70% 在肉眼几乎无差异的前提下可大幅削减扫描件与插图体积"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Fluent Expander for Advanced Controls -->
                        <Expander
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Header="高级参数与安全跳过策略">
                            <StackPanel Spacing="14" Padding="4,8,4,4">
                                <Grid ColumnSpacing="24" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <ToggleSwitch
                                        x:Name="GrayscaleToggle"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Header="将彩色位图转为灰度（适合黑白讲义/合同）"
                                        OffContent="保持原色彩"
                                        OnContent="转为灰度"
                                        Toggled="AdvancedToggle_Toggled" />

                                    <ToggleSwitch
                                        x:Name="StripMetadataToggle"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Header="清理文档冗余元数据 (XMP / Producer)"
                                        OffContent="保留元数据"
                                        OnContent="清理元数据"
                                        Toggled="AdvancedToggle_Toggled" />

                                    <ToggleSwitch
                                        x:Name="PreserveMtimeToggle"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Header="保留原文件修改时间 (LastWriteTime)"
                                        IsOn="True"
                                        OffContent="使用当前时间"
                                        OnContent="保留原修改时间"
                                        Toggled="AdvancedToggle_Toggled" />

                                    <ToggleSwitch
                                        x:Name="SkipOptimizedToggle"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Header="自动跳过历史已优化文件（支持增量续跑）"
                                        IsOn="True"
                                        OffContent="每次全部重压"
                                        OnContent="智能指纹跳过"
                                        Toggled="AdvancedToggle_Toggled" />
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <NumberBox
                                        x:Name="MinSavingBox"
                                        Grid.Column="0"
                                        Header="最小节省比例阈值 (%) · 低于此值保留原件"
                                        Minimum="0"
                                        Maximum="50"
                                        SmallChange="1"
                                        Value="1"
                                        SpinButtonPlacementMode="Inline"
                                        ValueChanged="AdvancedNumber_ValueChanged" />

                                    <NumberBox
                                        x:Name="SkipSmallBox"
                                        Grid.Column="1"
                                        Header="跳过小于该体积的文件 (KB, 0 为不限制)"
                                        Minimum="0"
                                        Maximum="512000"
                                        SmallChange="100"
                                        Value="0"
                                        SpinButtonPlacementMode="Inline"
                                        ValueChanged="AdvancedNumber_ValueChanged" />

                                    <NumberBox
                                        x:Name="WorkersBox"
                                        Grid.Column="2"
                                        Header="并行隔离子进程数 (Workers)"
                                        Minimum="1"
                                        Maximum="16"
                                        SmallChange="1"
                                        Value="4"
                                        SpinButtonPlacementMode="Inline"
                                        ValueChanged="AdvancedNumber_ValueChanged" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Card 3: Output Mode & Trial Batch Limit -->
                <Border Style="{StaticResource FluentCardBorderStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                Glyph="&#xE74E;"
                                FontSize="18"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock
                                Text="存储方式与试跑策略"
                                Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <RadioButton
                                x:Name="InplaceRadio"
                                Grid.Column="0"
                                GroupName="OutputModeGroup"
                                IsChecked="True"
                                Checked="OutputModeRadio_Checked"
                                HorizontalAlignment="Stretch">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="原地直接优化替换（60GB 海量首选）" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Text="无需额外准备 60GB 磁盘空间；同卷生成临时文件校验页数无误后原子替换，断电或变大绝不损毁原文件"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton
                                x:Name="OutDirRadio"
                                Grid.Column="1"
                                GroupName="OutputModeGroup"
                                Checked="OutputModeRadio_Checked"
                                HorizontalAlignment="Stretch">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="另存到新文件夹（保持多目录结构）" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Text="源文件完全不动，在目标文件夹下按源目录名称与子目录层级完整镜像输出"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                        </Grid>

                        <!-- Backup directory row (Inplace mode) -->
                        <Border
                            x:Name="BackupDirRow"
                            Style="{StaticResource FluentSubtleCardBorderStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="可选备份目录："
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox
                                    x:Name="BackupDirTextBox"
                                    Grid.Column="1"
                                    PlaceholderText="留空则直接原地覆盖（推荐）；如需保留未压缩备份可指定其它盘符目录"
                                    TextChanged="BackupDirTextBox_TextChanged" />
                                <Button Grid.Column="2" Content="浏览…" Click="PickBackupDir_Click" />
                                <Button Grid.Column="3" Content="清除" Click="ClearBackupDir_Click" />
                            </Grid>
                        </Border>

                        <!-- Output directory row (OutputDirectory mode) -->
                        <Border
                            x:Name="OutputDirRow"
                            Visibility="Collapsed"
                            Style="{StaticResource FluentSubtleCardBorderStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="导出目标目录："
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBox
                                    x:Name="OutputDirTextBox"
                                    Grid.Column="1"
                                    PlaceholderText="请选择压缩后 PDF 的保存目录…"
                                    TextChanged="OutputDirTextBox_TextChanged" />
                                <Button Grid.Column="2" Content="选择导出目录…" Click="PickOutputDir_Click" />
                            </Grid>
                        </Border>

                        <!-- Trial Batch Limit Selector -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="批量执行范围："
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="LimitAllBtn" Tag="0" Click="TrialLimit_Click" Content="全部待处理文件" />
                                <Button x:Name="Limit5Btn" Tag="5" Click="TrialLimit_Click" Content="先试跑前 5 个" />
                                <Button x:Name="Limit10Btn" Tag="10" Click="TrialLimit_Click" Content="先试跑前 10 个" />
                                <Button x:Name="Limit50Btn" Tag="50" Click="TrialLimit_Click" Content="先试跑前 50 个" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Sticky Bottom Fluent Command Bar -->
        <Border
            Grid.Row="1"
            Padding="28,14,28,14"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid MaxWidth="1120" HorizontalAlignment="Stretch" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon
                        Glyph="&#xEA18;"
                        FontSize="18"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock
                        x:Name="BottomSafetySummaryText"
                        Text="安全守护已开启：100% 保留矢量文字 · 页数完整性校验 · 变大自动保留原文件"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Click="GoCompare_Click"
                    Padding="16,8,16,8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A1;" FontSize="14" />
                        <TextBlock Text="单文件画质对比" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="StartBatchBtn"
                    Grid.Column="2"
                    Click="StartBatch_Click"
                    Style="{ThemeResource AccentButtonStyle}"
                    Padding="22,8,22,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock x:Name="StartBatchBtnText" Text="开始原地优化" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>

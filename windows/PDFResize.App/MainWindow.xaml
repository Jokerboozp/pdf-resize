<Window
    x:Class="PDFResize.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PDF Resize">

    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        DragOver="RootGrid_DragOver"
        DragLeave="RootGrid_DragLeave"
        Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Fluent Title Bar (Preserves Windows 11 Snap Layouts) -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="16,0,160,0"
            Background="Transparent">
            <StackPanel
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center">
                <FontIcon
                    Glyph="&#xEA90;"
                    FontSize="16"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock
                    Text="PDF Resize"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    VerticalAlignment="Center" />
                <Border
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="4"
                    Padding="7,2,7,2"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="WinUI 3 · Fluent"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <Border
                    x:Name="LiveSpeedPill"
                    Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,2,10,2"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ProgressRing
                            Width="12"
                            Height="12"
                            IsActive="True" />
                        <TextBlock
                            x:Name="LiveSpeedText"
                            Text="正在压缩…"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Fluent NavigationView Shell -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="244"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="True"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="NavWorkbench"
                    Tag="workbench"
                    Content="批量压缩">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NavCompare"
                    Tag="compare"
                    Content="画质对比">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NavJobs"
                    Tag="jobs"
                    Content="任务队列">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge
                            x:Name="JobsInfoBadge"
                            Visibility="Collapsed"
                            Value="0" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Border
                    Margin="12,4,12,8"
                    Padding="12,10,12,10"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="累计已释放磁盘空间"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="FooterSavedText"
                            Text="0 B"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock
                            x:Name="FooterWorkerHintText"
                            Text="原生隔离子进程引擎已就绪"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="GlobalInfoBar"
                    Grid.Row="0"
                    Margin="24,12,24,0"
                    IsOpen="False"
                    IsClosable="True" />

                <Frame
                    x:Name="ContentFrame"
                    Grid.Row="1" />
            </Grid>
        </NavigationView>

        <!-- Full-Window Explorer Drag-and-Drop Fluent Overlay -->
        <Grid
            x:Name="DropOverlay"
            Grid.RowSpan="2"
            Visibility="Collapsed"
            IsHitTestVisible="False"
            Background="{ThemeResource SmokeFillColorDefaultBrush}"
            Padding="36">
            <Border
                CornerRadius="12"
                BorderThickness="2"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="48,36,48,36">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <FontIcon
                        Glyph="&#xE896;"
                        FontSize="40"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="松开鼠标即可导入文件夹或 PDF"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="支持跨盘符同时拖入多个文件夹，系统将自动递归去重并保留矢量文字"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
